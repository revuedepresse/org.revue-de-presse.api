{% apply inline_css(source('newsletter/_styles/design-tokens.html.twig')) %}
<!DOCTYPE html><html lang="fr"><head><meta charset="utf-8"></head><body>
<table role="presentation" class="wrap" width="100%">
  <tr><td class="brand-header">{% include 'newsletter/_partials/brand-header.html.twig' %}</td></tr>
  <tr><td style="padding:16px">
    Bonjour,<br><br>
    Vous avez demandé à recevoir chaque matin {{ newsletter_name }}.<br><br>
    <strong>Une dernière étape&nbsp;: confirmez votre adresse <span style="white-space:nowrap">e-mail</span></strong> en cliquant sur le bouton <span style="white-space:nowrap">ci-dessous</span>.<br><br>
    <a href="{{ confirm_url }}" style="display:inline-block;background:#006663;color:#ffffff;text-decoration:none;border-radius:8px;padding:12px 24px;font-weight:bold">Confirmer mon adresse e-mail</a><br><br>
    Tant que votre adresse n'est pas confirmée, aucune lettre ne vous sera envoyée. Ce lien est valable {{ confirm_ttl_days }} jours.<br><br>
    Si vous n'êtes pas à l'origine de cette demande, ignorez ce message&nbsp;: vous ne serez pas abonné.
  </td></tr>
</table></body></html>
{% endapply %}
